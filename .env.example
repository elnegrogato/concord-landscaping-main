# Concord Landscaping — configuration examples
# Copy to .env.local and fill in your own values before building/deploying.

# --- Analytics (https://tagmanager.google.com / https://analytics.google.com) ---
# GTM container ID (e.g. GTM-ABCD123). If unset, no GTM/gtag code is injected.
NEXT_PUBLIC_GTM_ID=
# GA4 Measurement ID (e.g. G-ABCDEFG123).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Backend / Email ---
# Convex project name (set via `npx convex deploy` / Convex dashboard).
CONVEX_DEPLOYMENT=
# Resend API key (optional): email notifications when a lead arrives.
# Without it, leads are only logged to the console / stored in Convex.
RESEND_API_KEY=
