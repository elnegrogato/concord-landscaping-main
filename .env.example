# =====================================================================
# Concord Landscaping — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file containing real secrets.
# =====================================================================

# ----------------------------------------------------------------------------
# Public app URLs
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://concordlandscaping.com
SITE_URL=https://concordlandscaping.com
APP_NAME=Concord Landscaping
APP_ENV=development

# ----------------------------------------------------------------------------
# Convex (backend database + server functions)
# ----------------------------------------------------------------------------
# Hosted Convex:
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=your-deployment-name

# Self-hosted Convex (via docker-compose.convex.yml):
CONVEX_SELF_HOSTED_URL=http://convex:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=replace_with_generated_admin_key
CONVEX_CLOUD_ORIGIN=https://convex-api.yourdomain.com
CONVEX_SITE_ORIGIN=https://convex-site.yourdomain.com
NEXT_PUBLIC_DEPLOYMENT_URL=https://convex-api.yourdomain.com
INSTANCE_NAME=concord-landscaping-production
INSTANCE_SECRET=replace_with_32_plus_random_characters

# ----------------------------------------------------------------------------
# Authentication and sessions
# ----------------------------------------------------------------------------
AUTH_SESSION_SECRET=replace_with_32_plus_random_characters
AUTH_SESSION_EXPIRY_HOURS=24
ENCRYPTION_KEY=replace_with_32_plus_random_characters

# Rate limiting and access control
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MAX_CONCURRENT_SESSIONS=3
ALLOWED_ORIGINS=http://localhost:3000,https://concordlandscaping.com

# ----------------------------------------------------------------------------
# Stripe (billing, invoices, payments)
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_replace_me

# ----------------------------------------------------------------------------
# Twilio (SMS / voice webhook handlers in convex/http.ts)
# ----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC_replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_PHONE_NUMBER=+17045550192

# ----------------------------------------------------------------------------
# Email (React Email templates -> Resend, with safe local mock fallback)
# ----------------------------------------------------------------------------
RESEND_API_KEY=re_replace_me
EMAIL_FROM=noreply@concordlandscaping.com
EMAIL_FROM_NAME=Concord Landscaping
EMAIL_REPLY_TO=office@concordlandscaping.com
INTERNAL_LEAD_ALERT_EMAIL=office@concordlandscaping.com

# ----------------------------------------------------------------------------
# Google Calendar integration hooks
# ----------------------------------------------------------------------------
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_REDIRECT_URI=https://concordlandscaping.com/api/calendar/callback

# ----------------------------------------------------------------------------
# Optional AI / content generation
# ----------------------------------------------------------------------------
GEMINI_API_KEY=replace_me

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=

# ----------------------------------------------------------------------------
# Feature flags
# ----------------------------------------------------------------------------
ENABLE_AI_COPILOT=true
ENABLE_EMAIL_SENDING=false
ENABLE_SMS_SENDING=false
ENABLE_STRIPE=true
